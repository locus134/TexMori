{
  "name": "cptool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地纹理编码、预览与批处理工具",
  "author": "CPTool",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "test:integration": "vitest run tests/integration",
    "test:desktop": "playwright test",
    "package:mac": "npm run build && node scripts/prepare-release.mjs && electron-builder --mac --arm64"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "vite": "6.4.6",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
